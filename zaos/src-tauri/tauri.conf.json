{
  "productName": "ZAOS",
  "version": "0.1.0",
  "identifier": "com.zaos.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZAOS — Zep Agentic OS",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "focus": true,
        "theme": "dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "identifier": "com.zaos.app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
